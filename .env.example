# Copy to .env and fill in before `docker compose up -d --build`.
DOMAIN=m3105.ru

POSTGRES_DB=edu
POSTGRES_USER=edu
POSTGRES_PASSWORD=change-me-to-a-long-random-string

# Password for /admin (minimum 8 characters, use something long).
ADMIN_PASSWORD=change-me-too
# Optional token for scripts (scripts/content.ts): admin API without login, `Authorization: Bearer`.
# Generate with `openssl rand -hex 32`; 32+ characters.
ADMIN_API_TOKEN=

TZ=Europe/Moscow

# Student sign-in. Create a bot via @BotFather, then run /setdomain with your DOMAIN.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Local hour (site timezone) for the daily deadline digest from the bot.
BOT_DIGEST_HOUR=10
