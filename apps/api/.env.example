# Local development for the Go API (`make api` loads this file).
ADDR=:8080
APP_ENV=development
DATABASE_URL=postgres://edu:edu@localhost:5432/edu?sslmode=disable
# Leave VALKEY_ADDR empty to use in-memory sessions locally.
VALKEY_ADDR=localhost:6379
ADMIN_PASSWORD=dev-password-123
PUBLIC_URL=http://localhost:3000
COOKIE_SECURE=false
# Student sign-in (optional locally: DEV_LOGIN=true allows name-only login outside production).
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# WEBAUTHN_RP_ID defaults to the PUBLIC_URL host; WEBAUTHN_ORIGINS is a comma list of allowed origins.
