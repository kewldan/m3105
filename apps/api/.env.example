# Local development for the Go API (`make api` loads this file).
ADDR=:8080
APP_ENV=development
DATABASE_URL=postgres://edu:edu@localhost:5432/edu?sslmode=disable
# Leave VALKEY_ADDR empty to use in-memory sessions locally.
VALKEY_ADDR=localhost:6379
ADMIN_PASSWORD=dev-password-123
# Optional: bearer token for admin routes (32+ characters), used by scripts/content.ts.
ADMIN_API_TOKEN=
PUBLIC_URL=http://localhost:3000
COOKIE_SECURE=false
# Student sign-in (optional locally: DEV_LOGIN=true allows name-only login outside production).
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# WEBAUTHN_RP_ID defaults to the PUBLIC_URL host; WEBAUTHN_ORIGINS is a comma list of allowed origins.
# Attachments: MinIO from docker-compose.dev.yml (`make infra`). Alternatively leave
# S3_ENDPOINT empty and set FILES_DIR to keep files in a local directory.
S3_ENDPOINT=localhost:9000
S3_ACCESS_KEY=edu
S3_SECRET_KEY=edu-dev-password
S3_BUCKET=edu3105
FILES_DIR=
# Image previews via imgproxy from docker-compose.dev.yml; leave the URL empty to serve originals.
IMGPROXY_URL=http://localhost:8081
IMGPROXY_KEY=6465762d6b6579
IMGPROXY_SALT=6465762d73616c74
