# Проверки clang-tidy для страницы /cpp: Google C++ Style Guide плюс
# полезные проверки на ошибки. Шумное (магические числа, «легко перепутать
# параметры», trailing return type) выключено: это учебный код.
Checks: >
  -*,
  clang-diagnostic-*,
  google-*,
  -google-readability-todo,
  bugprone-*,
  -bugprone-easily-swappable-parameters,
  -bugprone-narrowing-conversions,
  performance-*,
  modernize-*,
  -modernize-use-trailing-return-type,
  -modernize-use-nodiscard,
  -modernize-avoid-c-arrays,
  -modernize-use-std-print,
  -modernize-use-designated-initializers,
  readability-identifier-naming,
  readability-container-size-empty,
  readability-else-after-return,
  readability-redundant-*,
  readability-make-member-function-const,
  readability-const-return-type,
  misc-unused-using-decls,
  misc-definitions-in-headers,
  cppcoreguidelines-pro-type-cstyle-cast,
  cppcoreguidelines-init-variables
CheckOptions:
  # Имена по Google: типы и функции PascalCase, переменные snake_case,
  # поля классов с подчёркиванием в конце, константы kName, макросы UPPER_CASE.
  readability-identifier-naming.NamespaceCase: lower_case
  readability-identifier-naming.ClassCase: CamelCase
  readability-identifier-naming.StructCase: CamelCase
  readability-identifier-naming.UnionCase: CamelCase
  readability-identifier-naming.EnumCase: CamelCase
  readability-identifier-naming.TypeAliasCase: CamelCase
  readability-identifier-naming.TypedefCase: CamelCase
  readability-identifier-naming.TemplateParameterCase: CamelCase
  readability-identifier-naming.FunctionCase: CamelCase
  readability-identifier-naming.MethodCase: CamelCase
  # Геттеры и сеттеры по Google называются как переменные: name(), set_name().
  readability-identifier-naming.MethodIgnoredRegexp: '^[a-z][a-z0-9_]*$'
  readability-identifier-naming.VariableCase: lower_case
  readability-identifier-naming.ParameterCase: lower_case
  readability-identifier-naming.MemberCase: lower_case
  readability-identifier-naming.PrivateMemberSuffix: _
  readability-identifier-naming.ProtectedMemberSuffix: _
  readability-identifier-naming.ConstexprVariableCase: CamelCase
  readability-identifier-naming.ConstexprVariablePrefix: k
  readability-identifier-naming.GlobalConstantCase: CamelCase
  readability-identifier-naming.GlobalConstantPrefix: k
  readability-identifier-naming.StaticConstantCase: CamelCase
  readability-identifier-naming.StaticConstantPrefix: k
  readability-identifier-naming.ClassConstantCase: CamelCase
  readability-identifier-naming.ClassConstantPrefix: k
  readability-identifier-naming.EnumConstantCase: CamelCase
  readability-identifier-naming.EnumConstantPrefix: k
  # Локальные константы Google разрешает называть и так, и так.
  readability-identifier-naming.LocalConstantIgnoredRegexp: '^(k[A-Z][A-Za-z0-9]*|[a-z][a-z0-9_]*)$'
  readability-identifier-naming.MacroDefinitionCase: UPPER_CASE
